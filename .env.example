LARIMIA_ENV=development
LARIMIA_AUTH_MODE=demo
LARIMIA_DATABASE_URL=postgresql+psycopg://larimia:larimia@postgres:5432/larimia
LARIMIA_REDIS_URL=redis://redis:6379/0
LARIMIA_CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
LARIMIA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LARIMIA_OIDC_ISSUER=https://auth.codestra.co/realms/larimia
LARIMIA_OIDC_AUDIENCE=larimia-api
LARIMIA_OIDC_JWKS_URL=https://auth.codestra.co/realms/larimia/protocol/openid-connect/certs
LARIMIA_OIDC_ALLOWED_ALGORITHMS=RS256
LARIMIA_OIDC_CLOCK_SKEW_SECONDS=30

# Fail closed. High-risk capabilities remain disabled until provider,
# authorization, reconciliation and operational certification passes.
LARIMIA_ENABLED_CAPABILITIES=request_intake,quotes
LARIMIA_PAYMENT_PROVIDER_CODE=sandbox
LARIMIA_PAYMENT_PROVIDER_CODES=sandbox
LARIMIA_PAYMENT_HTTP_TIMEOUT_SECONDS=10
LARIMIA_PLATFORM_FEE_BPS=2000
LARIMIA_PROVIDER_PAYABLE_HOLD_HOURS=24

LARIMIA_STRIPE_SECRET_KEY=
LARIMIA_STRIPE_PUBLISHABLE_KEY=
LARIMIA_STRIPE_WEBHOOK_SECRET=
LARIMIA_STRIPE_API_VERSION=
LARIMIA_STRIPE_API_BASE=https://api.stripe.com/v1

LARIMIA_PAYPAL_CLIENT_ID=
LARIMIA_PAYPAL_CLIENT_SECRET=
LARIMIA_PAYPAL_WEBHOOK_ID=
LARIMIA_PAYPAL_ENVIRONMENT=sandbox
LARIMIA_PAYPAL_RETURN_URL=http://localhost:3000/checkout/paypal/return
LARIMIA_PAYPAL_CANCEL_URL=http://localhost:3000/checkout/paypal/cancel

# Payout batches can be prepared and approved, but live submission remains
# fail-closed until a certified payout adapter is configured.
LARIMIA_PAYOUT_PROVIDER_CODE=disabled

LARIMIA_WEBSOCKET_REDIS_URL=redis://redis:6379/1
LARIMIA_REALTIME_STREAM_MAXLEN=10000
LARIMIA_WEBSOCKET_TICKET_TTL_SECONDS=30
LARIMIA_WEBHOOK_SECRETS_JSON={}
LARIMIA_WEBHOOK_REPLAY_WINDOW_SECONDS=300
LARIMIA_MAX_WEBHOOK_BYTES=1048576
LARIMIA_LOG_LEVEL=INFO

LARIMIA_RELEASE_VERSION=0.5.0
LARIMIA_GIT_SHA=unknown
LARIMIA_IMAGE_DIGEST=unknown
LARIMIA_MIGRATION_HEAD=0008
