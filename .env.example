# Prefer `make setup`: it creates independent random LOCAL credentials, mode 0600.
# Never use demo identity or local payment simulation to serve real transactions.
LARIMIA_ENV=development
LARIMIA_AUTH_MODE=local
LARIMIA_LOCAL_JWT_SECRET=
LARIMIA_DB_PASSWORD=
LARIMIA_DATABASE_URL=
LARIMIA_DATABASE_URL_FILE=
LARIMIA_REDIS_URL=redis://redis:6379/0
LARIMIA_REDIS_URL_FILE=
LARIMIA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LARIMIA_PAYMENT_MODE=mock
LARIMIA_PAYMENT_WEBHOOK_SECRET=
LARIMIA_SEED_PASSWORD=
LARIMIA_STORAGE_ROOT=/var/lib/larimia/storage
LARIMIA_OIDC_ISSUER=
LARIMIA_OIDC_AUDIENCE=larimia-api
LARIMIA_OIDC_JWKS_URL=
LARIMIA_BUILD_VERSION=local
# Staging requires OIDC, TLS DB settings, explicit CORS and provisioned identities.
LARIMIA_WORKFORCE_OIDC_ISSUER=
LARIMIA_WORKFORCE_OIDC_AUDIENCE=
LARIMIA_WORKFORCE_OIDC_JWKS_URL=
LARIMIA_TELEMETRY_OTLP_ENDPOINT=

# External channels are opt-in and disabled until an adapter is configured.
LARIMIA_NOTIFICATION_MODE=disabled
LARIMIA_NOTIFICATION_RELAY_URL=
LARIMIA_NOTIFICATION_RELAY_TOKEN=
