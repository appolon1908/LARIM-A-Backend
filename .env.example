LARIMIA_ENV=development
LARIMIA_AUTH_MODE=demo
LARIMIA_DATABASE_URL=postgresql+psycopg://larimia:larimia@postgres:5432/larimia
LARIMIA_REDIS_URL=redis://redis:6379/0
LARIMIA_CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
LARIMIA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Canonical identity host. Production validation rejects alternate hosts.
LARIMIA_OIDC_ISSUER=https://auth.codestra.co/realms/larimia
LARIMIA_OIDC_AUDIENCE=larimia-api
LARIMIA_OIDC_JWKS_URL=https://auth.codestra.co/realms/larimia/protocol/openid-connect/certs
LARIMIA_OIDC_ALLOWED_ALGORITHMS=RS256
LARIMIA_OIDC_CLOCK_SKEW_SECONDS=30

# Fail closed by default. Enable high-risk capabilities only after readiness gates pass.
LARIMIA_ENABLED_CAPABILITIES=request_intake,quotes
LARIMIA_LOG_LEVEL=INFO

LARIMIA_PAYMENT_PROVIDER_CODE=sandbox
LARIMIA_PAYOUT_PROVIDER_CODE=disabled
LARIMIA_WEBSOCKET_REDIS_URL=redis://redis:6379/1
LARIMIA_REALTIME_STREAM_MAXLEN=10000
LARIMIA_WEBSOCKET_TICKET_TTL_SECONDS=30
LARIMIA_WEBHOOK_SECRETS_JSON={}
LARIMIA_MAX_WEBHOOK_BYTES=1048576

# Immutable release identity is mandatory in production.
LARIMIA_RELEASE_VERSION=0.3.0
LARIMIA_GIT_SHA=unknown
LARIMIA_IMAGE_DIGEST=unknown
LARIMIA_MIGRATION_HEAD=0005
