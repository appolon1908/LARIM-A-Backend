{
  "schemaVersion": 1,
  "repository": "appolon1908-hue/LARIM-A-Backend",
  "serviceIdentity": "larimia-api",
  "namespacePrefix": "larim-a/api/runtime/",
  "delivery": "agent-rendered-file",
  "bindings": [
    {
      "setting": "LARIMIA_DATABASE_URL",
      "fileEnvironment": "LARIMIA_DATABASE_URL_FILE",
      "secretName": "database-url",
      "required": true
    },
    {
      "setting": "LARIMIA_REDIS_URL",
      "fileEnvironment": "LARIMIA_REDIS_URL_FILE",
      "secretName": "redis-url",
      "required": true
    },
    {
      "setting": "LARIMIA_CELERY_BROKER_URL",
      "fileEnvironment": "LARIMIA_CELERY_BROKER_URL_FILE",
      "secretName": "celery-broker-url",
      "required": true
    }
  ],
  "runtimeVerified": false,
  "secretValuesIncluded": false
}
